# ---------- Supabase ----------
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ---------- Web ----------
NEXT_PUBLIC_APP_NAME=WA Automations
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------- API ----------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# 32-byte hex key for AES-256-GCM encryption of WABA tokens. Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY=

# ---------- Redis / queues (optional — campaigns run in-process without it) ----------
REDIS_URL=redis://localhost:6379

# ---------- Meta WhatsApp Cloud API ----------
META_GRAPH_API_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# WhatsApp Embedded Signup configuration id (Meta App dashboard → WhatsApp →
# Embedded Signup). Enables the one-click "Connect WhatsApp with Meta" button;
# the web app fetches these from the API, so no NEXT_PUBLIC_ copies are needed.
META_CONFIG_ID=

# ---------- Payments (optional; wallet top-ups are disabled without these) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set in the Razorpay dashboard under Webhooks; distinct from the API secret.
RAZORPAY_WEBHOOK_SECRET=
